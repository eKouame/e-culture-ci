# Connexion Postgres (Neon). Tableau de bord Neon > votre projet > Connect >
# copiez la "Connection string" en mode "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Même connexion, mais SANS "-pooler" dans le nom d'hôte (mode "Direct
# connection" dans Neon). Utilisée uniquement par la CLI Prisma pour les
# migrations : la connexion pooled ne supporte pas l'advisory lock requis
# par `prisma migrate deploy` (erreur P1002).
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Identifiants créés par `npx prisma db seed` (optionnel, valeurs par défaut sinon)
ADMIN_SEED_EMAIL="admin@culture.gouv.ci"
ADMIN_SEED_PASSWORD="ChangeMoi123!"
